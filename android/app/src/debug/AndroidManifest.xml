<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application>
        <!-- adb hook for E2E scripts; debug builds only. -->
        <receiver
            android:name="app.bedrock.debug.DemoReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="app.bedrock.debug.DEMO"/>
                <action android:name="app.bedrock.debug.EVENT"/>
                <action android:name="app.bedrock.debug.EVALUATE"/>
                <action android:name="app.bedrock.debug.WARN"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
