<?xml version="1.0" encoding="utf-8"?>
<!-- Window CONTENT retrieval is on because in-app feed blocking needs it to
     tell a feed apart from DMs. It is the narrowest thing that works: content
     events arrive for every package, but FeedDetector returns on packages with
     no rules before it ever asks for the window, so only the handful of social
     apps in FeedRules are ever inspected.

     packageNames is intentionally NOT set. Whole-app blocking needs
     window-state events from every package, and packageNames filters all event
     types, not just content ones.

     This must stay in sync with the Play accessibility declaration and with the
     in-app disclosure in onboarding_flow.dart (_PrivacyNote). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="50"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description" />
